<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    TestNG Suite — это конфигурационный файл, который говорит TestNG:
    - Какие тесты запускать
    - В каком порядке
    - Сколько потоков использовать (parallel execution)
    - Какие listeners подключить

    parallel="methods" — каждый @Test метод будет выполняться в отдельном потоке.
    thread-count="4" — максимум 4 потока одновременно.
    Это позволяет ускорить прогон тестов в 3-4 раза.
-->
<suite name="Regression Suite" parallel="methods" thread-count="4">

    <!-- Listeners — классы, которые "подслушивают" события тестирования -->
    <listeners>
        <!-- AllureListener — делает скриншоты при падении и прикрепляет к отчёту -->
        <listener class-name="listeners.AllureListener"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="tests.ui.LoginTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="tests.api.UserApiTest"/>
        </classes>
    </test>

    <test name="E2E Tests">
        <classes>
            <class name="tests.e2e.E2EUserFlowTest"/>
        </classes>
    </test>

</suite>
